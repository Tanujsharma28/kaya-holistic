# Vercel > Project > Settings > Environment Variables me ye set karo.

# Backend ka live URL, /api ke saath (bina trailing slash)
VITE_API_URL=https://your-backend-domain.com/api

# Google OAuth Web client ID (backend ke GOOGLE_CLIENT_ID jaisa)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Sirf testing ke liye. Live jaate waqt hata do.
# VITE_PAYMENTS_PAUSED=true