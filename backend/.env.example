# Copy this file to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=5000

# Production me database ko persistent disk pe point karo (warna redeploy par bookings mit jaayengi)
DB_FILE=./data/db.json

# Frontend ka live URL (comma se multiple allowed, CORS ke liye bhi use hota hai)
CLIENT_URL=https://kaya-holistic.vercel.app

# ── Admin login ──
ADMIN_EMAIL=your_admin_email@example.com
# bcrypt hash banane ke liye: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here
# Kam se kam 32 characters ka random string
JWT_SECRET=replace_with_a_random_32_plus_char_string

# ── Email (bookings/reminders ke liye) — Gmail ya SMTP, dono me se ek set karo ──
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_EMAIL=your_smtp_email@example.com
SMTP_PASSWORD=your_smtp_app_password
CLINIC_OWNER_EMAIL=your_clinic_email@example.com
CLINIC_REPLY_TO=

# ── Google Calendar / Meet (online consultation ke liye) ──
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_CALENDAR_ID=primary
GOOGLE_MEET_LINK=https://meet.google.com/guq-qmdy-mpd

# ── Stripe (sirf $45 Virtual Skin Consultation ka payment) ──
# Test mode me "sk_test_..." / "pk_test_..." se shuru hote hain, live me "sk_live_..." / "pk_live_...".
STRIPE_SECRET_KEY=
# Stripe Dashboard > Developers > Webhooks > Apna endpoint add karke yahan se milega ("whsec_..." se shuru hota hai)
STRIPE_WEBHOOK_SECRET=
ADMIN_2FA=true
# ADMIN_2FA_EMAIL=koi.aur@email.com   (optional: code kisi aur email pe chahiye to)
# ── TESTING ONLY ──
# true rakhne par $45 consultation bina payment ke book ho jaati hai. Production me mat rakho.
# PAYMENTS_PAUSED=true